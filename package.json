    "lens-extension",
    "kubernetes",
    "dashboards",
    "perses",
    "prometheus",
    "thanos",
    "metrics",
    "observability",
    "ai-agent"
  ],
  "homepage": "https://github.com/koncar/lens-glance#readme",
  "bugs": {
    "url": "https://github.com/koncar/lens-glance/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koncar/lens-glance.git"
  },
  "license": "MIT",
  "author": "Stevan Koncar <stev.koncar@gmail.com>",
  "type": "commonjs",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
